# The results of these fixtures depend on the host, so they are recorded on each host instead of being archived:
# `make_switch_host.sh` on whether the file system has executable bits and ignores the case of file names, and
# `make_switch_symlinks.sh` on symbolic links, which archives can't represent on all hosts.
make_switch_host.tar
make_switch_host_sha256.tar
make_switch_symlinks.tar
make_switch_symlinks_sha256.tar
